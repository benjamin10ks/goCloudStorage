{{define "passkey_login"}}
<div id="auth-step">
    <p style="text-align: center; color: var(--text-muted); margin: 1rem 0;">
        <span class="spinner" style="display: inline-block; margin-right: 0.5rem;"></span>
        Authenticating with passkey...
    </p>
    <script>
    (async () => {
        try {
            const beginResp = await fetch('/auth/login/passkey/begin/0', {
                method: 'POST'
            });
            
            if (!beginResp.ok) {
                throw new Error('Failed to begin login');
            }
            
            const options = await beginResp.json();
            
            // Decode challenge
            options.publicKey.challenge = base64ToBuffer(options.publicKey.challenge);
            if (options.publicKey.allowCredentials) {
                options.publicKey.allowCredentials = options.publicKey.allowCredentials.map(cred => ({
                    ...cred,
                    id: base64ToBuffer(cred.id)
                }));
            }
            
            // Trigger passkey
            const credential = await navigator.credentials.get(options);
            
            // Send result
            const finishResp = await fetch('/auth/login/passkey/finish/0', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(credential)
            });
            
            if (finishResp.ok) {
                window.location.href = '/home';
            } else {
                document.getElementById('auth-step').innerHTML = 
                    '<div class="alert alert-error">Authentication failed. Please try again.</div>' +
                    '<button class="btn btn-primary" style="width: 100%;" onclick="location.reload()">Try Again</button>';
            }
        } catch (error) {
            console.error('Passkey error:', error);
            document.getElementById('auth-step').innerHTML = 
                '<div class="alert alert-error">Authentication failed: ' + error.message + '</div>' +
                '<button class="btn btn-primary" style="width: 100%;" onclick="location.reload()">Try Again</button>';
        }
    })();
    
    function base64ToBuffer(base64) {
        const binary = atob(base64.replace(/-/g, '+').replace(/_/g, '/'));
        return Uint8Array.from(binary, c => c.charCodeAt(0)).buffer;
    }
    </script>
</div>
{{end}}
