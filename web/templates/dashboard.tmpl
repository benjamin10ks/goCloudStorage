{{template "app_layout" .}}
{{define "title"}}Dashboard - Cloud Storage{{end}}

{{define "main_content"}}
<div id="files-container">
    {{if .Files}}
    <div class="grid">
        {{range .Files}}
        {{template "file_card" .}}
        {{end}}
    </div>
    {{else}}
    <div class="empty-state">
        <div class="empty-state-icon">📁</div>
        <h2 class="empty-state-title">No files yet</h2>
        <p>Upload your first file to get started</p>
        <button class="btn btn-primary" style="margin-top: 1rem;" onclick="document.getElementById('upload-input').click()">
            <span>⬆️</span> Upload File
        </button>
    </div>
    {{end}}
</div>

<!-- File modals loaded via HTMX -->
<div id="modal-container"></div>
{{end}}
