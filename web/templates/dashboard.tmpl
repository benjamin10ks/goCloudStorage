{{template "app_layout" .}}
{{define "title"}}Dashboard - Cloud Storage{{end}}

{{define "main_content"}}
<div id="files-container">
    {{if .Files}}
    <div class="grid" id="files-grid">
        {{range .Files}}
        {{template "file_card" .}}
        {{end}}
    </div>
    {{else}}
    <div class="grid" id="files-grid" style="display: none;"></div>
    <div class="empty-state" id="empty-state">
        <div class="empty-state-icon">📁</div>
        <h2 class="empty-state-title">No files yet</h2>
        <p>Upload your first file to get started</p>
        <button class="btn btn-primary" style="margin-top: 1rem;" onclick="document.getElementById('upload-input').click()">
            <span>⬆️</span> Upload File
        </button>
    </div>
    {{end}}
</div>

<!-- Hidden upload form -->
<form id="upload-form" style="display: none;">
    <input type="file" 
           id="upload-input" 
           name="file"
           onchange="handleFileUpload(this)">
</form>

<!-- Upload Progress Overlay -->
<div id="upload-overlay" class="upload-overlay" style="display: none;">
    <div style="background: white; border-radius: 16px; padding: 2rem; min-width: 400px; box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
            <div class="spinner"></div>
            <div>
                <div style="font-weight: 600; font-size: 1.1rem;">Uploading file...</div>
                <div style="color: var(--text-muted); font-size: 0.9rem;" id="upload-filename"></div>
            </div>
        </div>
        <div style="background: var(--bg-main); border-radius: 8px; height: 8px; overflow: hidden; margin-bottom: 0.5rem;">
            <div id="upload-progress-bar" style="background: var(--primary); height: 100%; width: 0%; transition: width 0.3s;"></div>
        </div>
        <div style="text-align: center; font-size: 0.9rem; color: var(--text-muted);">
            <span id="upload-percentage">0%</span> • <span id="upload-size">0 KB / 0 KB</span>
        </div>
    </div>
</div>

<!-- File modals loaded via HTMX -->
<div id="modal-container"></div>

<script>
document.body.addEventListener('showToast', function(evt) {
    const detail = evt.detail.value;
    const toast = document.createElement('div');
    toast.className = 'toast toast-' + detail.type;
    toast.textContent = detail.message;
    toast.style.cssText = 'padding: 1rem 1.5rem; background: ' + 
        (detail.type === 'success' ? 'var(--success)' : 'var(--danger)') + 
        '; color: white; border-radius: 8px; margin-bottom: 0.5rem; box-shadow: var(--shadow);';
    
    const container = document.getElementById('toast-container');
    container.appendChild(toast);
    
    setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s';
        setTimeout(() => toast.remove(), 300);
    }, 3000);
});

document.body.addEventListener('fileUploaded', function() {
    const emptyState = document.getElementById('empty-state');
    const filesGrid = document.getElementById('files-grid');
    
    if (emptyState && filesGrid) {
        emptyState.style.display = 'none';
        filesGrid.style.display = 'grid';
    }
    
    document.getElementById('upload-input').value = '';
});

function formatBytes(bytes) {
    if (bytes === 0) return '0 KB';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
}

function handleFileUpload(input) {
    const file = input.files[0];
    if (!file) return;
    
    const overlay = document.getElementById('upload-overlay');
    const progressBar = document.getElementById('upload-progress-bar');
    const percentage = document.getElementById('upload-percentage');
    const sizeDisplay = document.getElementById('upload-size');
    const filename = document.getElementById('upload-filename');
    
    filename.textContent = file.name;
    overlay.style.display = 'flex';
    
    const formData = new FormData();
    formData.append('file', file);
    
    const xhr = new XMLHttpRequest();
    
    xhr.upload.addEventListener('progress', function(e) {
        if (e.lengthComputable) {
            const percent = Math.round((e.loaded / e.total) * 100);
            progressBar.style.width = percent + '%';
            percentage.textContent = percent + '%';
            sizeDisplay.textContent = formatBytes(e.loaded) + ' / ' + formatBytes(e.total);
        }
    });
    
    xhr.addEventListener('load', function() {
        if (xhr.status === 200 || xhr.status === 201) {
            const emptyState = document.getElementById('empty-state');
            const filesGrid = document.getElementById('files-grid');
            
            if (emptyState) emptyState.style.display = 'none';
            if (filesGrid) {
                filesGrid.style.display = 'grid';
                filesGrid.insertAdjacentHTML('afterbegin', xhr.responseText);
            }
            
            overlay.style.display = 'none';
            progressBar.style.width = '0%';
            input.value = '';
            
            const toast = new CustomEvent('showToast', {
                detail: { value: { type: 'success', message: 'File uploaded successfully!' } }
            });
            document.body.dispatchEvent(toast);
        } else {
            overlay.style.display = 'none';
            progressBar.style.width = '0%';
            
            const toast = new CustomEvent('showToast', {
                detail: { value: { type: 'error', message: 'Upload failed. Please try again.' } }
            });
            document.body.dispatchEvent(toast);
        }
    });
    
    xhr.addEventListener('error', function() {
        overlay.style.display = 'none';
        progressBar.style.width = '0%';
        
        const toast = new CustomEvent('showToast', {
            detail: { value: { type: 'error', message: 'Upload failed. Please try again.' } }
        });
        document.body.dispatchEvent(toast);
    });
    
    xhr.open('POST', '/api/files/upload');
    xhr.send(formData);
}
</script>
{{end}}
