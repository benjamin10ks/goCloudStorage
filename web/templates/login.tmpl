{{define "title"}}Login - Cloud Storage{{end}}

{{define "auth_content"}}
<div class="auth-header">
    <div class="auth-logo">☁️</div>
    <h1 class="auth-title">Welcome Back</h1>
    <p class="auth-subtitle">Sign in to access your files</p>
</div>

{{if .Error}}
<div class="alert alert-error">{{.Error}}</div>
{{end}}

<div id="auth-form">
    <!-- Passkey Login -->
    <button type="button" class="btn btn-passkey" 
            hx-post="/auth/login/passkey/begin/0" 
            hx-target="#auth-form"
            hx-swap="innerHTML">
        <span>🔐</span>
        <span>Sign in with Passkey</span>
        <span class="htmx-indicator spinner"></span>
    </button>
    
    <div class="divider">
        <span>or continue with</span>
    </div>
    
    <!-- GitHub OAuth -->
    <form action="/auth/github" method="POST">
        <button type="submit" class="btn btn-github">
            <span>🐙</span>
            <span>Sign in with GitHub</span>
        </button>
    </form>
</div>

<div class="auth-link">
    Don't have an account? <a href="/auth/register">Create one</a>
</div>
{{end}}
